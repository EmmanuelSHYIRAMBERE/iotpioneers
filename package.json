{
  "name": "iotpioneers-web",
  "version": "0.1.0",
  "private": true,
  "description": "Corporate landing page for IoT PIONEERS Ltd, Kigali, Rwanda.",
  "scripts": {
    "dev": "cross-env ALLOW_UNVERIFIED_CONTENT=true next dev",
    "prebuild": "tsx scripts/checkContent.ts",
    "build": "next build",
    "build:preview": "cross-env ALLOW_UNVERIFIED_CONTENT=true tsx scripts/checkContent.ts --report && cross-env ALLOW_UNVERIFIED_CONTENT=true next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "lhci": "lhci autorun",
    "check:content": "tsx scripts/checkContent.ts",
    "validate": "npm run lint && npm run typecheck && npm run test && tsx scripts/checkContent.ts --report",
    "format": "prettier --write ."
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "gsap": "^3.13.0",
    "lucide-react": "^0.550.0",
    "motion": "^12.23.0",
    "next": "^16.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwind-merge": "^3.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@eslint/eslintrc": "^3.3.1",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.56.0",
    "@tailwindcss/postcss": "^4.1.14",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.18.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.4",
    "cross-env": "^10.1.0",
    "eslint": "^9.37.0",
    "eslint-config-next": "^16.0.0",
    "jsdom": "^27.0.0",
    "prettier": "^3.6.2",
    "prettier-plugin-tailwindcss": "^0.7.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.0",
    "vitest": "^3.2.4",
    "zod": "^4.1.12"
  }
}
